  </ItemGroup>

  <ItemGroup>
    <None Include="..\Ecosologic.Infrastructure\Email\EmailAssets\email-logo.png" Link="EmailAssets\email-logo.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

